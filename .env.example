# Copy this file to .env (same folder) and put your key below.
# .env is ignored by git. Never commit or share the key.
#
# Environment: sandbox (keys start with fp_test_) or live (keys start with fp_live_).
FP_ENV=sandbox
FP_API_KEY=
#
# Optional: folder for logs and tables. Default: Documents/TradeBlackbox in your home folder.
# FP_DATA_DIR=
